{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arbiter final decision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "idea_id": {
      "type": "string",
      "minLength": 1
    },
    "idea_version": {
      "type": "integer",
      "minimum": 1
    },
    "arbiter_run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "provisional",
        "needs_human_review",
        "already_addressed",
        "approved",
        "rejected"
      ]
    },
    "rni": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "eas": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "novelty_criteria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "N1": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rating": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "rating",
            "rationale",
            "evidence_ids"
          ]
        },
        "N2": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
