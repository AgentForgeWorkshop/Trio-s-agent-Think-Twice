{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent agent assessment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "idea_id": {
      "type": "string",
      "minLength": 1
    },
    "idea_version": {
      "type": "integer",
      "minimum": 1
    },
    "agent_id": {
      "type": "string",
      "enum": [
        "theorist",
        "challenger"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "locked_initial": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "provisional",
        "needs_human_review",
        "already_addressed",
        "approved",
        "rejected"
      ]
    },
    "rni": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "eas": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "novelty_criteria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "N1": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rating": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "rating",
            "rationale",
            "evidence_ids"
          ]
        },
        "N2": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rating": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "rating",
            "rationale",
            "evidence_ids"
          ]
        },
        "N3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rating": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "rating",
            "rationale",
            "evidence_ids"
          ]
        },
        "N4": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rating": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "rating",
            "rationale",
            "evidence_ids"
          ]
        },
        "N5": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rating": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "rating",
            "rationale",
            "evidence_ids"
          ]
        }
      },
      "required": [
        "N1",
        "N2",
        "N3",
        "N4",
        "N5"
      ]
    },
    "adequacy_criteria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "E1": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rating": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "rating",
            "rationale",
            "evidence_ids"
          ]
        },
        "E2": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rating": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "rating",
            "rationale",
            "evidence_ids"
          ]
        },
        "E3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rating": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "rating",
            "rationale",
            "evidence_ids"
          ]
        },
        "E4": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rating": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "rating",
            "rationale",
            "evidence_ids"
          ]
        },
        "E5": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rating": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "rating",
            "rationale",
            "evidence_ids"
          ]
        }
      },
      "required": [
        "E1",
        "E2",
        "E3",
        "E4",
        "E5"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "stance": {
            "type": "string",
            "enum": [
              "supports_novelty",
              "challenges_novelty",
              "context"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "claim_id",
          "text",
          "stance",
          "evidence_ids"
        ]
      }
    },
    "search_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "engine": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "searched_at": {
            "type": "string",
            "minLength": 1
          },
          "result_count": {
            "type": "integer",
            "minimum": 0
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "engine",
          "query",
          "searched_at",
          "result_count",
          "limitations"
        ]
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "idea_id",
    "idea_version",
    "agent_id",
    "run_id",
    "locked_initial",
    "status",
    "rni",
    "eas",
    "novelty_criteria",
    "adequacy_criteria",
    "claims",
    "search_log",
    "unresolved_questions",
    "summary"
  ]
}
